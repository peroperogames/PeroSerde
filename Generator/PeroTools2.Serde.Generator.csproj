<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <Authors>PeroperoGames</Authors>
        <Company>PeroperoGames</Company>
        <Title>PeroSerde.Generator</Title>
        <PackageId>PeroTools2.Serde.Generator</PackageId>
        <AssemblyName>PeroTools2.Serde.Generator</AssemblyName>
        <RootNamespace>PeroTools2.Serde.Generator</RootNamespace>
        <Description>Generator for PeroSerde.</Description>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <Copyright>© 2026 PeroperoGames</Copyright>
        <PackageProjectUrl>https://github.com/peroperogames/PeroSerde</PackageProjectUrl>
        <RepositoryUrl>https://github.com/peroperogames/PeroSerde</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryType>git</RepositoryType>
        <Version>0.2.0</Version>
        <AssemblyVersion>0.2.0</AssemblyVersion>
        <FileVersion>0.2.0</FileVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="3.9.0" PrivateAssets="all"/>
    </ItemGroup>

    <Target Name="PostBuild" BeforeTargets="PostBuildEvent">
        <PropertyGroup>
            <UnitySupportVer>'netstandard2.0'</UnitySupportVer>
            <DotNetVer>'$([System.IO.Path]::GetFileName('$(OutDir.TrimEnd('\'))'))'</DotNetVer>
            <UnityOutDir>$(ProjectDir)..\Unity\Plugins</UnityOutDir>
        </PropertyGroup>
        <ItemGroup>
            <UnityOutFiles Include="$(UnityOutDir)\*.*"/>
            <ProjDlls Include="$(OutputPath)$(ProjectName).dll"/>
            <ProjDlls Include="$(OutputPath)$(ProjectName).mdb" Condition="Exists('$(OutputPath)$(ProjectName).mdb')"/>
            <ProjDlls Include="$(OutputPath)$(ProjectName).pdb" Condition="Exists('$(OutputPath)$(ProjectName).pdb')"/>
        </ItemGroup>
        <Copy SourceFiles="@(ProjDlls)" DestinationFolder="$(UnityOutDir)" SkipUnchangedFiles="true" Condition=" $(DotNetVer) == $(UnitySupportVer) "/>
    </Target>


</Project>
