<#@ template language="C#" #>
<#@ output extension=".cs" encoding="utf-8" #>
using System;
using System.Runtime.CompilerServices;

namespace PeroTools2.Serde {
    public static partial class NumberHelper {
<#
    var fpTypes = new[] { "Float", "Double" };
    var utfTypes = new[] { "Utf16", "Utf8" };
    foreach (var fpType in fpTypes) {
    foreach (var utf in utfTypes) {
        var charType = utf == "Utf16" ? "char" : "byte";
        var castStr = utf == "Utf16" ? "" : "(byte) ";
        var maxStrLenConstName = $"max_{fpType.ToLower()}_string_length";
        var maxDigitalConstName = $"s_Max{fpType}DigitalLength";
#>
        /// <summary>将一个<#= fpType.ToLower() #>值格式化为<#= utf.ToLower() #>字符串.</summary>
        /// <remarks>
        /// 必须确保dest的空间足够, 最大需要<see cref="<#= maxStrLenConstName #>"/>个字节
        /// </remarks>
        public static unsafe int To<#= utf #>StringUnsafe(<#= fpType.ToLower() #> value, <#= charType #>* dest)
        {
            // TODO 特殊值的处理？需要提供几种方式
            if (IsSpecialValue(value))
            {
                SerdeException.ThrowInvalidFloatPoint();
                return default;
            }
            var start = dest;
            // 按需写入负号
            if (value < 0)
            {
                *dest = <#= castStr #>negative_sign;
                dest++;
                value = -value;
            }
            // 获取浮点数的指数部分
            var exponent = GetExponent(value);
            // 整数部分的长度. 如果整数位数超过最大位数或为负数, 需要使用科学计数法, 此时整数长度为1
            var lengthOfInteger = exponent >= 0 && exponent < <#= maxDigitalConstName #> ? exponent + 1 : 1;
            // 小数部分的长度 + 1(用于四舍五入)
            var lengthOfFractional = <#= maxDigitalConstName #> - lengthOfInteger;
            // exponent此时代表科学计数法的指数部分. 如果为0代表不需要使用科学计数法.
            if (exponent < <#= maxDigitalConstName #> && exponent > -max_floating_zero_length)
            {
                exponent = 0;
            }
            // 将浮点数的有效部分转换为整数来处理: 123.45678 => 12345678
            var mantissa = (ulong) Pow(value, lengthOfFractional - exponent);

            {
                ulong temp;
                // 对最后一位进行四舍五入
                if (lengthOfFractional >= 1)
                {
                    temp = mantissa / 10;
                    if (mantissa - temp * 10 >= 5)
                        mantissa = temp + 1;
                    else
                        mantissa = temp;
                    lengthOfFractional -= 1;
                }
                // 去掉尾随0
                while (lengthOfFractional >= 4 && mantissa == (temp = mantissa / 10000) * 10000)
                {
                    mantissa = temp;
                    lengthOfFractional -= 4;
                }
                while (lengthOfFractional > 0 && mantissa == (temp = mantissa / 10) * 10)
                {
                    mantissa = temp;
                    lengthOfFractional -= 1;
                }
            }
            // 写入数字
            if (lengthOfFractional == 0) // 没有小数位的情况, 直接按照整数写入.
            {
                var <#= charType #>sWritten = To<#= utf #>StringUnsafe(mantissa, dest);
                if (<#= charType #>sWritten > lengthOfInteger && exponent != 0)
                {
                    exponent += 1;
                    <#= charType #>sWritten -= 1;
                }
                dest += <#= charType #>sWritten;
            }
            else
            {
                // 有小数位的部分, 先按照整数写入, 再写入小数点
                To<#= utf #>StringUnsafe(mantissa, dest);
                dest += lengthOfInteger;
                // 小数部分整体向后错一位, 来放小数点
                for (var i = lengthOfFractional; i > 0;)
                {
                    dest[i] = dest[--i];
                }
                *dest = <#= castStr #>dot_sign;
                dest += lengthOfFractional + 1;
            }
            // 如果需要科学计数法, 写入科学计数法部分
            if (exponent != 0)
            {
                dest[0] = <#= castStr #>exponent_sign;
                if (exponent > 0) {
                    dest[1] = <#= castStr #>positive_sign;
                    dest += 2;
                    dest += To<#= utf #>StringUnsafe((ulong) exponent, dest);
                } else {
                    dest[1] = <#= castStr #>negative_sign;
                    dest += 2;
                    dest += To<#= utf #>StringUnsafe((ulong) (-exponent), dest);
                }
            }
            return (int) (dest - start);
        }
<# }} #>
    }
}