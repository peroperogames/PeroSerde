 * Author: AidenMX
 * Created On: 2024/03/08
 * Description: PrimitiveFormatter
 */

using System.Runtime.CompilerServices;

namespace PeroTools2.Serde.Json
{
<#
    var primitiveTypes = new[]
    {
        "Bool", "Byte", "Sbyte", "Ushort", "Short", "Uint", "Int", "Ulong", "Long", "Float", "Double", "Decimal", "Char"
    };
    var notStringTypes = new[]
    {
        "Bool", "Byte", "Sbyte", "Ushort", "Short", "Uint", "Int", "Ulong", "Long", "Float", "Double", "Decimal"
    };

    string GetRequiredSize(string typeName)
    {
        return typeName.ToLower() switch {
            "bool" => "5", // true or false
            "byte" => "3", // 0 ~ 255
            "sbyte" => "4", // -128 ~ 127
            "ushort" => "5", // 0 ~ 65535
            "short" => "6", // -32768 ~ 32767
            "uint" => "10", // 0 ~ 4294967295
            "int" => "11", // -2147483648 ~ 2147483647
            "char" => "8", // 8 是 Unicode 转义 + 引号
            "ulong" => "20", // 0 ~ 18446744073709551615
            "long" => "20", // -9223372036854775808 到 9223372036854775807
            "float" => "24",
            "double" => "32",
            "decimal" => "32",
            _ => throw new ArgumentOutOfRangeException(nameof(typeName))
            };
    }

    string GetNullableRequiredSize(string typeName)
    {
        return typeName.ToLower() switch {
            "bool" => "5", // true or false
            "byte" => "4", // 0 ~ 255 or null
            "sbyte" => "4", // -128 ~ 127
            "ushort" => "5", // 0 ~ 65535
            "short" => "6", // -32768 ~ 32767
            "uint" => "10", // 0 ~ 4294967295
            "int" => "11", // -2147483648 ~ 2147483647
            "char" => "8", // 8 是 Unicode 转义 + 引号
            "ulong" => "20", // 0 ~ 18446744073709551615
            "long" => "20", // -9223372036854775808 到 9223372036854775807
            "float" => "24",
            "double" => "32",
            "decimal" => "32",
            _ => throw new ArgumentOutOfRangeException(nameof(typeName))
            };
    }

    string GetDeserializerBody(string typeName, bool utf8Or16, bool isNull)
    {
        return $"JsonReader.Read{(isNull ? "Nullable" : string.Empty)}{typeName}{(utf8Or16 ? "Utf8" : "Utf16")}(src, out advance);";
    }

    string GetFormatFunctionName(string typeName, bool utf8Or16)
    {
        return "JsonWriter.Write"
            + typeName switch
            {
                "Byte" or "Ushort" or "Uint" or "Ulong" => "Ulong",
                "Sbyte" or "Short" or "Int" or "Long" => "Long",
                _ => typeName
            }
            + (utf8Or16 ? "Utf8" : "Utf16");
    }
#>
    static partial class SerdeJsonFormatterProvider
    {
        private static void RegisterPrimitiveFormatters()
        {
<#
    foreach
        (var typeName in
            primitiveTypes
        )
    {
#>
            Register(new <#= typeName #>Formatter());
<#
        if (typeName != "String")
        {
#>
            Register(new Nullable<#= typeName #>Formatter());
<#
        }
    }
#>
        }
    }

<#
    foreach (var typeName in primitiveTypes)
    {
        var typeNameLower = typeName.ToLower();
#>
    public sealed class <#= typeName #>Formatter : IFixedSerdeJsonFormatter<<#= typeNameLower #>>
    {
        public const int max_size = <#= GetRequiredSize(typeName) #>;

        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public int GetMaxRequiredSizeUtf8() => max_size;

        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public int GetMaxRequiredSizeUtf16() => max_size;

        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public unsafe int SerializeUtf8Unsafe(<#= typeNameLower #> value, byte* dest) => <#= GetFormatFunctionName(typeName, true) #>(dest, value);

        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public unsafe int SerializeUtf16Unsafe(<#= typeNameLower #> value, char* dest) => <#= GetFormatFunctionName(typeName, false) #>(dest, value);

        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public unsafe <#= typeNameLower #> DeserializeUtf8Unsafe(byte* src, out int advance) => <#= GetDeserializerBody(typeName, true, false) #>

        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public unsafe <#= typeNameLower #> DeserializeUtf16Unsafe(char* src, out int advance) => <#= GetDeserializerBody(typeName, false, false) #>
    }

<#
        if (typeName != "String")
        {
#>
    public sealed class Nullable<#= typeName #>Formatter : IFixedSerdeJsonFormatter<<#= typeNameLower #>?>
    {
        public const int max_size = <#= GetNullableRequiredSize(typeName) #>;

        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public int GetMaxRequiredSizeUtf8() => max_size;

        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public int GetMaxRequiredSizeUtf16() => max_size;

        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public unsafe int SerializeUtf8Unsafe(<#= typeNameLower #>? value, byte* dest) =>
            value == null
                ? JsonWriter.WriteNullUtf8(dest)
                : <#= GetFormatFunctionName(typeName, true) #>(dest, value.Value);

        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public unsafe int SerializeUtf16Unsafe(<#= typeNameLower #>? value, char* dest) =>
            value == null
                ? JsonWriter.WriteNullUtf16(dest)
                : <#= GetFormatFunctionName(typeName, false) #>(dest, value.Value);

        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public unsafe <#= typeNameLower #>? DeserializeUtf8Unsafe(byte* src, out int advance) => <#= GetDeserializerBody(typeName, true, true) #>

        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public unsafe <#= typeNameLower #>? DeserializeUtf16Unsafe(char* src, out int advance) => <#= GetDeserializerBody(typeName, false, true) #>
    }

<#
        }
    }
#>
    public class StringPrimitiveFormatter : <#= string.Join(",", notStringTypes.Select(static t => $"IFixedSerdeJsonFormatter<{t.ToLower()}>")) #>
    {
<#
    foreach (var typeName in notStringTypes)
    {
        var typeNameLower = typeName.ToLower();
#>
        int IFixedSerdeJsonFormatter<<#= typeNameLower #>>.GetMaxRequiredSizeUtf8() => <#= typeName #>Formatter.max_size + 2;

        int IFixedSerdeJsonFormatter<<#= typeNameLower #>>.GetMaxRequiredSizeUtf16() => <#= typeName #>Formatter.max_size + 2;

        unsafe int IFixedSerdeJsonFormatter<<#= typeNameLower #>>.SerializeUtf8Unsafe(<#= typeNameLower #> value, byte* dest) 
        {
            var origin = dest;
            dest += JsonWriter.WriteDoubleQuoteUtf8(dest);
            dest += <#= GetFormatFunctionName(typeName, true) #>(dest, value);
            dest += JsonWriter.WriteDoubleQuoteUtf8(dest);
            return (int)(dest - origin);
        }

        unsafe int IFixedSerdeJsonFormatter<<#= typeNameLower #>>.SerializeUtf16Unsafe(<#= typeNameLower #> value, char* dest)
        {
            var origin = dest;
            dest += JsonWriter.WriteDoubleQuoteUtf16(dest);
            dest += <#= GetFormatFunctionName(typeName, false) #>(dest, value);
            dest += JsonWriter.WriteDoubleQuoteUtf16(dest);
            return (int)(dest - origin);
        }

        unsafe <#= typeNameLower #> IFixedSerdeJsonFormatter<<#= typeNameLower #>>.DeserializeUtf8Unsafe(byte* src, out int advance)
        {
            var result = JsonReader.ReadValueUntilEndUtf8(src, <#= typeName #>Formatter.max_size + 2, out advance);
            return SpanConverter.To<#= typeName #>(result);
        }

        unsafe <#= typeNameLower #> IFixedSerdeJsonFormatter<<#= typeNameLower #>>.DeserializeUtf16Unsafe(char* src, out int advance)
        {
            var result = JsonReader.ReadValueUntilEndUtf16(src, <#= typeName #>Formatter.max_size + 2, out advance);
            return SpanConverter.To<#= typeName #>(result);
        }
<#
    }
#>
    }
    public class NullableStringPrimitiveFormatter : <#= string.Join(",", notStringTypes.Select(static t => $"IFixedSerdeJsonFormatter<{t.ToLower()}?>")) #>
    {
<#
    foreach (var typeName in notStringTypes)
    {
        var typeNameLower = typeName.ToLower() + "?";
#>
        int IFixedSerdeJsonFormatter<<#= typeNameLower #>>.GetMaxRequiredSizeUtf8() => Nullable<#= typeName #>Formatter.max_size + 2;

        int IFixedSerdeJsonFormatter<<#= typeNameLower #>>.GetMaxRequiredSizeUtf16() => Nullable<#= typeName #>Formatter.max_size + 2;

        unsafe int IFixedSerdeJsonFormatter<<#= typeNameLower #>>.SerializeUtf8Unsafe(<#= typeNameLower #> value, byte* dest)
        {
            if(value == null) return JsonWriter.WriteNullUtf8(dest);
            var origin = dest;
            dest += JsonWriter.WriteDoubleQuoteUtf8(dest);
            dest += <#= GetFormatFunctionName(typeName, true) #>(dest, value.Value);
            dest += JsonWriter.WriteDoubleQuoteUtf8(dest);
            return (int)(dest - origin);
        }

        unsafe int IFixedSerdeJsonFormatter<<#= typeNameLower #>>.SerializeUtf16Unsafe(<#= typeNameLower #> value, char* dest)
        {
            if(value == null) return JsonWriter.WriteNullUtf16(dest);
            var origin = dest;
            dest += JsonWriter.WriteDoubleQuoteUtf16(dest);
            dest += <#= GetFormatFunctionName(typeName, false) #>(dest, value.Value);
            dest += JsonWriter.WriteDoubleQuoteUtf16(dest);
            return (int)(dest - origin);
        }

        unsafe <#= typeNameLower #> IFixedSerdeJsonFormatter<<#= typeNameLower #>>.DeserializeUtf8Unsafe(byte* src, out int advance)
        {
            var result = JsonReader.ReadValueUntilEndUtf8(src, Nullable<#= typeName #>Formatter.max_size + 2, out advance);
            if (SpanConverter.IsNull(result)) return null;
            return SpanConverter.To<#= typeName #>(result);
        }

        unsafe <#= typeNameLower #> IFixedSerdeJsonFormatter<<#= typeNameLower #>>.DeserializeUtf16Unsafe(char* src, out int advance)
        {
            var result = JsonReader.ReadValueUntilEndUtf16(src, Nullable<#= typeName #>Formatter.max_size + 2, out advance);
            if (SpanConverter.IsNull(result)) return null;
            return SpanConverter.To<#= typeName #>(result);
        }
<#
    }
#>
    }
}