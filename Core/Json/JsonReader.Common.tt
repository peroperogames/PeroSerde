using System;
using System.Collections.Generic;
using System.Runtime.CompilerServices;

namespace PeroTools2.Serde.Json;
<#
foreach (var utf in new[] {"Utf8", "Utf16"})
{
    var charType = utf == "Utf8" ? "byte" : "char";
    var castStr = utf == "Utf8" ? "(byte) " : "";
    var directReaders = new[]
    {
        (method: "ReadInt32Value", type: "int", parse: "ReadIntFast", span: true),
        (method: "ReadInt64Value", type: "long", parse: "ReadLongFast", span: true),
        (method: "ReadInt16Value", type: "short", parse: "ReadShort", span: false),
        (method: "ReadUInt16Value", type: "ushort", parse: "ReadUshort", span: false),
        (method: "ReadByteValue", type: "byte", parse: "ReadByte", span: false),
        (method: "ReadSByteValue", type: "sbyte", parse: "ReadSbyte", span: false),
        (method: "ReadUInt32Value", type: "uint", parse: "ReadUint", span: false),
        (method: "ReadUInt64Value", type: "ulong", parse: "ReadUlong", span: false),
        (method: "ReadSingleValue", type: "float", parse: "ReadFloatFast", span: true),
        (method: "ReadDoubleValue", type: "double", parse: "ReadDoubleFast", span: true),
        (method: "ReadDecimalValue", type: "decimal", parse: "ReadDecimal", span: false),
        (method: "ReadBooleanValue", type: "bool", parse: "ReadBoolFast", span: true),
        (method: "ReadCharValue", type: "char", parse: "ReadCharFast", span: true)
    };
#>
public unsafe ref struct JsonReader<#= utf #>
{
    private int m_Advanced;
    private readonly ReadOnlySpan<<#= charType #>> m_Json;

    public readonly ReadOnlySpan<<#= charType #>> json => m_Json;

    public readonly ReadOnlySpan<<#= charType #>> remains
    {
        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        get => m_Json.Slice(m_Advanced, m_Json.Length - m_Advanced);
    }

    public JsonReader<#= utf #>(ReadOnlySpan<<#= charType #>> json)
    {
        m_Advanced = 0;
        m_Json = json;
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    internal void Advance(int count) => m_Advanced += count;

    #region Read Value

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public ReadOnlySpan<<#= charType #>> ReadValue(bool readComma = false)
    {
        var result = ReadUntilEnd();
        if (readComma) ReadComma();
        return result;
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public unsafe T ReadValue<T>(IFixedSerdeJsonFormatter<T> formatter, bool readComma = false)
    {
        T result;
        var span = remains;
        fixed (<#= charType #>* ptr = span)
        {
            result = formatter.Deserialize<#= utf #>Unsafe(ptr, out var advance);
            Advance(advance);
        }

        if (readComma) ReadComma();
        return result;
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public T ReadValue<T>(ISerdeJsonFormatter<T> formatter, bool readComma = false)
    {
        var span = remains;
        var result = formatter.Deserialize<#= utf #>(ref span, ref this);
        if (readComma) ReadComma();
        return result;
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public T ReadValue<T>(bool readComma = false)
    {
        // The per-call resolution is cached per registration, so the hot path pays one version compare instead of the
        // three generic static reads and interface casts GetFormatterInternal performs on every call.
        SerdeJsonFormatterProvider.Resolve<T>(out var fixedFormatter, out var unfixedFormatter);
        if (fixedFormatter != null)
            return ReadValue(fixedFormatter, readComma);
        if (unfixedFormatter != null)
            return ReadValue(unfixedFormatter, readComma);
        throw SerdeException.ThrowFormatterNotFound(typeof(T));
    }

    #endregion

    #region Read Value Directly

<#
foreach (var reader in directReaders)
{
#>
    /// <summary>Reads a primitive with the same parse as its formatter, without the formatter lookup and interface call.</summary>
    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public <#= reader.type #> <#= reader.method #>(bool readComma = false)
    {
<#
    if (reader.span)
    {
#>
        var value = JsonReader.<#= reader.parse #><#= utf #>(remains, out var advance);
        Advance(advance);
<#
    }
    else
    {
#>
        var span = remains;
        <#= reader.type #> value;
        fixed (<#= charType #>* src = span)
        {
            value = JsonReader.<#= reader.parse #><#= utf #>(src, out var advance);
            Advance(advance);
        }
<#
    }
#>

        if (readComma) ReadComma();
        return value;
    }

<#
}
#>
    /// <summary>Reads a string value through the single-allocation fast path, without the formatter indirection.</summary>
    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public string ReadStringValue(bool readComma = false)
    {
        var value = JsonReader.ReadStringValue<#= utf #>(remains, out var advance);
        Advance(advance);
        if (readComma) ReadComma();
        return value;
    }

    #endregion

    #region Read Collection Directly

<#
var directCollectionReaders = new[]
{
    (method: "ReadInt32Value", type: "int"),
    (method: "ReadInt64Value", type: "long"),
    (method: "ReadInt16Value", type: "short"),
    (method: "ReadUInt16Value", type: "ushort"),
    (method: "ReadByteValue", type: "byte"),
    (method: "ReadSByteValue", type: "sbyte"),
    (method: "ReadUInt32Value", type: "uint"),
    (method: "ReadUInt64Value", type: "ulong"),
    (method: "ReadSingleValue", type: "float"),
    (method: "ReadDoubleValue", type: "double"),
    (method: "ReadDecimalValue", type: "decimal"),
    (method: "ReadBooleanValue", type: "bool"),
    (method: "ReadCharValue", type: "char"),
    (method: "ReadStringValue", type: "string")
};
foreach (var reader in directCollectionReaders)
{
    var elementName = reader.method.Substring(0, reader.method.Length - "Value".Length);
#>
    /// <summary>Reads an array of primitive values, parsing every element without the formatter indirection.</summary>
    public <#= reader.type #>[] <#= elementName #>Array(bool readComma = false)
    {
        if (TryReadNull())
        {
            return null;
        }

        var buffer = ListPool<<#= reader.type #>>.shared.Rent();
        try
        {
            ReadBeginArray();
            ReadWhiteSpace();
            if ((uint) m_Advanced >= (uint) m_Json.Length)
            {
                throw SerdeException.ThrowInvalidJson(m_Json.ToString());
            }

            if (m_Json[m_Advanced] == <#= castStr #>']')
            {
                Advance(1);
                if (readComma) ReadComma();
                return Array.Empty<<#= reader.type #>>();
            }

            while (true)
            {
                ReadWhiteSpace();
                if ((uint) m_Advanced >= (uint) m_Json.Length)
                {
                    throw SerdeException.ThrowInvalidJson(m_Json.ToString());
                }

                buffer.Add(<#= reader.method #>());
                // The value parse leaves us on the delimiter (numbers skip their trailing whitespace, strings do not),
                // so one whitespace skip and two character compares replace the generic TryReadChar helper here.
                ReadWhiteSpace();
                if ((uint) m_Advanced >= (uint) m_Json.Length)
                {
                    throw SerdeException.ThrowInvalidJson(m_Json.ToString());
                }
                var delimiter = m_Json[m_Advanced];
                if (delimiter == <#= castStr #>',')
                {
                    Advance(1);
                    continue;
                }
                if (delimiter == <#= castStr #>']')
                {
                    Advance(1);
                    break;
                }
                throw SerdeException.ThrowInvalidJson(m_Json.ToString());
            }

            if (readComma) ReadComma();
            return buffer.ToArray();
        }
        finally
        {
            ListPool<<#= reader.type #>>.shared.Return(buffer);
        }
    }

    /// <summary>Reads a list of primitive values, parsing every element without the formatter indirection.</summary>
    public List<<#= reader.type #>> <#= elementName #>List(bool readComma = false)
    {
        if (TryReadNull())
        {
            return null;
        }

        var list = new List<<#= reader.type #>>();
        ReadBeginArray();
        ReadWhiteSpace();
        if ((uint) m_Advanced >= (uint) m_Json.Length)
        {
            throw SerdeException.ThrowInvalidJson(m_Json.ToString());
        }

        if (m_Json[m_Advanced] == <#= castStr #>']')
        {
            Advance(1);
            if (readComma) ReadComma();
            return list;
        }

        while (true)
        {
            ReadWhiteSpace();
            if ((uint) m_Advanced >= (uint) m_Json.Length)
            {
                throw SerdeException.ThrowInvalidJson(m_Json.ToString());
            }

            list.Add(<#= reader.method #>());
            ReadWhiteSpace();
            if ((uint) m_Advanced >= (uint) m_Json.Length)
            {
                throw SerdeException.ThrowInvalidJson(m_Json.ToString());
            }
            var delimiter = m_Json[m_Advanced];
            if (delimiter == <#= castStr #>',')
            {
                Advance(1);
                continue;
            }
            if (delimiter == <#= castStr #>']')
            {
                Advance(1);
                break;
            }
            throw SerdeException.ThrowInvalidJson(m_Json.ToString());
        }

        if (readComma) ReadComma();
        return list;
    }

<#
}
#>
    #endregion

    #region Read Collection

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    internal TCollection ReadCollection<TCollection, T>(ISerdeJsonFormatter<T> formatter, bool readComma = false) where TCollection : ICollection<T>, new()
    {
        if (TryReadNull())
        {
            return default;
        }

        var col = new TCollection();
        ReadCollection(col, formatter, readComma);
        return col;
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    internal TCollection ReadCollection<TCollection, T>(IFixedSerdeJsonFormatter<T> formatter, bool readComma = false) where TCollection : ICollection<T>, new()
    {
        if (TryReadNull())
        {
            return default;
        }

        var col = new TCollection();
        ReadCollection(col, formatter, readComma);
        return col;
    }

    internal void ReadCollection<T>(ICollection<T> col, IFixedSerdeJsonFormatter<T> formatter, bool readComma)
    {
        ReadBeginArray();
        ReadWhiteSpace();
        if ((uint) m_Advanced >= (uint) m_Json.Length)
        {
            throw SerdeException.ThrowInvalidJson(m_Json.ToString());
        }

        if(m_Json[m_Advanced] == <#= castStr #>']')
        {
            Advance(1);
            return;
        }
        while (true)
        {
            ReadWhiteSpace();
            if ((uint) m_Advanced >= (uint) m_Json.Length)
            {
                throw SerdeException.ThrowInvalidJson(m_Json.ToString());
            }

            col.Add(ReadValue(formatter));
            ReadWhiteSpace();
            if (m_Json[m_Advanced] == <#= castStr #>',')
            {
                Advance(1);
            }
            else if (m_Json[m_Advanced] == <#= castStr #>']')
            {
                Advance(1);
                break;
            }
        }
        if (readComma) ReadComma();
    }

    internal void ReadCollection<T>(ICollection<T> col, ISerdeJsonFormatter<T> formatter, bool readComma)
    {
        ReadBeginArray();
        ReadWhiteSpace();
        if ((uint) m_Advanced >= (uint) m_Json.Length)
        {
            throw SerdeException.ThrowInvalidJson(m_Json.ToString());
        }

        if(m_Json[m_Advanced] == <#= castStr #>']')
        {
            Advance(1);
            return;
        }
        while (true)
        {
            ReadWhiteSpace();
            if ((uint) m_Advanced >= (uint) m_Json.Length)
            {
                throw SerdeException.ThrowInvalidJson(m_Json.ToString());
            }

            col.Add(ReadValue(formatter));
            ReadWhiteSpace();
            if (m_Json[m_Advanced] == <#= castStr #>',')
            {
                Advance(1);
            }
            else if (m_Json[m_Advanced] == <#= castStr #>']')
            {
                Advance(1);
                break;
            }
        }
        if (readComma) ReadComma();
    }

    #endregion

    #region Read Literal

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public unsafe ReadOnlySpan<<#= charType #>> ReadUntilEnd()
    {
        var span = remains;
        fixed (<#= charType #>* src = remains)
        {
            var result = JsonReader.ReadValueUntilEnd<#= utf #>(src, span.Length - 1, out var advance);
            Advance(advance);
            return result;
        }
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public void ReadWhiteSpace()
    {
        for (var i = m_Advanced; i < m_Json.Length; i++)
        {
            if (StringHelper.IsWhiteSpace(m_Json[i])) continue;
            Advance(i - m_Advanced);
            return;
        }
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public void ReadBeginObject() => ReadChar('{');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public void ReadEndObject() => ReadChar('}');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public void ReadBeginArray() => ReadChar('[');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public void ReadEndArray() => ReadChar(']');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public void ReadKeyBegin() => ReadChar(':');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public void ReadComma() => ReadChar(',');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public bool TryReadBeginObject() => TryReadChar('{');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public bool TryReadEndObject() => TryReadChar('}');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public bool TryReadBeginArray() => TryReadChar('[');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public bool TryReadEndArray() => TryReadChar(']');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public bool TryReadKeyBegin() => TryReadChar(':');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public bool TryReadComma()
    {
        var json = m_Json;
        var index = m_Advanced;
        while (index < json.Length && StringHelper.IsWhiteSpace(json[index])) index++;
        m_Advanced = index;
        if (index >= json.Length || json[index] != <#= castStr #>',')
        {
            return false;
        }

        // Consume the comma only: the next key read skips the whitespace in front of the next key
        m_Advanced = index + 1;
        return true;
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public bool TryReadNull()
    {
        var length = m_Json.Length - m_Advanced;
        var span = m_Json.Slice(m_Advanced, length);
        // Up to 4 characters are needed, hence the length of Length - 3
        for (var i = 0; i < span.Length - 3; i++)
        {
            if (StringHelper.IsWhiteSpace(span[i])) continue;
            // Find consecutive nulls
            if (span[i] == <#= castStr #>'n' && span[i + 1] == <#= castStr #>'u' && span[i + 2] == <#= castStr #>'l' && span[i + 3] == <#= castStr #>'l')
            {
                Advance(i + 4);
                return true;
            }
            return false;
        }
        return false;
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public ReadOnlySpan<<#= charType #>> ReadKey()
    {
        ReadWhiteSpace();
        var key = ReadString();
        ReadWhiteSpace();
        ReadKeyBegin();
        ReadWhiteSpace();
        return key;
    }

    /// <summary>Reads the next object key and consumes its colon.</summary>
    /// <remarks>
    /// This runs once per member, so it walks the buffer directly instead of going through the whitespace, quote and
    /// character helpers: one whitespace skip, one vectorised quote search and one whitespace skip before the colon.
    /// Keys that contain escapes keep the general path.
    /// </remarks>
    public bool TryReadKey(out ReadOnlySpan<<#= charType #>> key)
    {
        var json = m_Json;
        var index = m_Advanced;
        while (index < json.Length && StringHelper.IsWhiteSpace(json[index])) index++;
        if (index >= json.Length || json[index] != <#= castStr #>'"')
        {
            m_Advanced = index;
            key = default;
            return false;
        }

        var start = index + 1;
        var end = JsonReader.IndexOfQuoteOrBackslash<#= utf #>(json, start);
        if (end < 0)
        {
            throw SerdeException.ThrowInvalidJson(json.ToString());
        }

        if (json[end] == <#= castStr #>'\\')
        {
            // Escaped key: fall back to the general string reader, which has to restart from the opening quote
            m_Advanced = index;
            key = ReadString();
            ReadWhiteSpace();
            ReadKeyBegin();
            ReadWhiteSpace();
            return true;
        }

        key = json.Slice(start, end - start);
        index = end + 1;
        while (index < json.Length && StringHelper.IsWhiteSpace(json[index])) index++;
        if (index >= json.Length || json[index] != <#= castStr #>':')
        {
            throw SerdeException.ThrowInvalidJson(json.ToString());
        }

        // Skip the whitespace after the colon so the value reader starts on the value itself
        index++;
        while (index < json.Length && StringHelper.IsWhiteSpace(json[index])) index++;
        m_Advanced = index;
        return true;
    }

    private ReadOnlySpan<<#= charType #>> ReadString()
    {
        if (m_Json[m_Advanced] != <#= castStr #>'"')
        {
            throw SerdeException.ThrowInvalidJson(m_Json.ToString());
        }

        // Track escapes by skipping the escaped character: outside a string a JSON text holds only quotes and
        // backslashes, so one vectorised search per special character keeps the common case at a single scan.
        var position = m_Advanced + 1;
        while (true)
        {
            var found = JsonReader.IndexOfQuoteOrBackslash<#= utf #>(m_Json, position);
            if (found < 0)
            {
                throw SerdeException.ThrowInvalidJson(m_Json.ToString());
            }

            if (m_Json[found] == <#= castStr #>'"')
            {
                var result = m_Json.Slice(m_Advanced + 1, found - m_Advanced - 1);
                Advance(found + 1 - m_Advanced);
                return result;
            }

            position = found + 2;
            if (position >= m_Json.Length)
            {
                throw SerdeException.ThrowInvalidJson(m_Json.ToString());
            }
        }
    }

    /// <summary>
    /// Reads characters until the first target character is encountered
    /// </summary>
    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    private void ReadChar(char c)
    {
        ReadWhiteSpace();
        if (remains[0] != <#= castStr #>c)
        {
            throw SerdeException.ThrowInvalidJson(m_Json.ToString());
        }
        Advance(1);
    }

    /// <summary>
    /// Reads characters until the first target character is encountered
    /// </summary>
    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    private bool TryReadChar(char c)
    {
        var length = m_Json.Length - m_Advanced;
        var span = m_Json.Slice(m_Advanced, length);
        for (var i = 0; i < span.Length; i++)
        {
            if (StringHelper.IsWhiteSpace(span[i])) continue;
            if (span[i] == <#= castStr#>c)
            {
                Advance(i + 1);
                return true;
            }
            return false;
        }
        return false;
    }

    #endregion
}
<#
}
#>
