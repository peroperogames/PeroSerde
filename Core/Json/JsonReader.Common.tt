using System;
using System.Collections.Generic;
using System.Runtime.CompilerServices;

namespace PeroTools2.Serde.Json;
<#
foreach (var utf in new[] {"Utf8", "Utf16"})
{
    var charType = utf == "Utf8" ? "byte" : "char";
    var castStr = utf == "Utf8" ? "(byte) " : "";
#>
public unsafe ref struct JsonReader<#= utf #>
{
    private int m_Advanced;
    private readonly ReadOnlySpan<<#= charType #>> m_Json;

    /// <summary>Base address of the buffer, set only when the entry point pinned it.</summary>
    private readonly <#= charType #>* m_Base;

    private readonly bool m_HasBase;
    public readonly ReadOnlySpan<<#= charType #>> json => m_Json;

    public readonly ReadOnlySpan<<#= charType #>> remains
    {
        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        get => m_Json.Slice(m_Advanced, m_Json.Length - m_Advanced);
    }

    public JsonReader<#= utf #>(ReadOnlySpan<<#= charType #>> json)
    {
        m_Advanced = 0;
        m_Json = json;
        m_Base = null;
        m_HasBase = false;
    }

    /// <summary>Creates a reader over an already pinned buffer; <paramref name="basePtr"/> points at its start.</summary>
    internal JsonReader<#= utf #>(ReadOnlySpan<<#= charType #>> json, <#= charType #>* basePtr)
    {
        m_Advanced = 0;
        m_Json = json;
        m_Base = basePtr;
        m_HasBase = true;
    }

    /// <summary>Creates a cursor at the current position; the buffer must have been pinned by the entry point.</summary>
    public JsonCursor<#= utf #> CreateCursor()
    {
        if (!m_HasBase)
        {
            throw new NotSupportedException(
                "JsonCursor<#= utf #> requires a pinned buffer. Use JsonConverter.Deserialize instead of calling the formatter directly.");
        }

        return new JsonCursor<#= utf #>(m_Base + m_Advanced, m_Base + m_Json.Length);
    }

    /// <summary>Synchronizes the cursor position back into the reader.</summary>
    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public void SyncCursor(in JsonCursor<#= utf #> cursor)
    {
        m_Advanced = (int) (cursor.p - m_Base);
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    internal void Advance(int count) => m_Advanced += count;

    /// <summary>Synchronizes the length consumed by the generated cursor back into the reader.</summary>
    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public void SkipConsumed(int count) => m_Advanced += count;

    #region Read Value

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public ReadOnlySpan<<#= charType #>> ReadValue(bool readComma = false)
    {
        var result = ReadUntilEnd();
        if (readComma) ReadComma();
        return result;
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public unsafe T ReadValue<T>(IFixedSerdeJsonFormatter<T> formatter, bool readComma = false)
    {
        T result;
        var span = remains;
        fixed (<#= charType #>* ptr = span)
        {
            result = formatter.Deserialize<#= utf #>Unsafe(ptr, out var advance);
            Advance(advance);
        }

        if (readComma) ReadComma();
        return result;
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public T ReadValue<T>(ISerdeJsonFormatter<T> formatter, bool readComma = false)
    {
        var span = remains;
        var result = formatter.Deserialize<#= utf #>(ref span, ref this);
        if (readComma) ReadComma();
        return result;
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public T ReadValue<T>(bool readComma = false)
    {
        var formatter = SerdeJsonFormatterProvider.GetFormatterInternal<T>();
        if (formatter is IFixedSerdeJsonFormatter<T> fixedFormatter)
            return ReadValue(fixedFormatter, readComma);
        if (formatter is ISerdeJsonFormatter<T> unfixedFormatter)
            return ReadValue(unfixedFormatter, readComma);
        throw SerdeException.ThrowFormatterNotFound(typeof(T));
    }

    #endregion

    #region Read Collection

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    internal TCollection ReadCollection<TCollection, T>(ISerdeJsonFormatter<T> formatter, bool readComma = false) where TCollection : ICollection<T>, new()
    {
        if (TryReadNull())
        {
            return default;
        }

        var col = new TCollection();
        ReadCollection(col, formatter, readComma);
        return col;
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    internal TCollection ReadCollection<TCollection, T>(IFixedSerdeJsonFormatter<T> formatter, bool readComma = false) where TCollection : ICollection<T>, new()
    {
        if (TryReadNull())
        {
            return default;
        }

        var col = new TCollection();
        ReadCollection(col, formatter, readComma);
        return col;
    }

    internal void ReadCollection<T>(ICollection<T> col, IFixedSerdeJsonFormatter<T> formatter, bool readComma)
    {
        ReadBeginArray();
        ReadWhiteSpace();
        if(m_Json[m_Advanced] == <#= castStr #>']')
        {
            Advance(1);
            return;
        }
        while (true)
        {
            ReadWhiteSpace();
            col.Add(ReadValue(formatter));
            ReadWhiteSpace();
            if (m_Json[m_Advanced] == <#= castStr #>',')
            {
                Advance(1);
            }
            else if (m_Json[m_Advanced] == <#= castStr #>']')
            {
                Advance(1);
                break;
            }
        }
        if (readComma) ReadComma();
    }

    internal void ReadCollection<T>(ICollection<T> col, ISerdeJsonFormatter<T> formatter, bool readComma)
    {
        ReadBeginArray();
        ReadWhiteSpace();
        if(m_Json[m_Advanced] == <#= castStr #>']')
        {
            Advance(1);
            return;
        }
        while (true)
        {
            ReadWhiteSpace();
            col.Add(ReadValue(formatter));
            ReadWhiteSpace();
            if (m_Json[m_Advanced] == <#= castStr #>',')
            {
                Advance(1);
            }
            else if (m_Json[m_Advanced] == <#= castStr #>']')
            {
                Advance(1);
                break;
            }
        }
        if (readComma) ReadComma();
    }

    #endregion

    #region Read Literal

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public unsafe ReadOnlySpan<<#= charType #>> ReadUntilEnd()
    {
        var span = remains;
        fixed (<#= charType #>* src = remains)
        {
            var result = JsonReader.ReadValueUntilEnd<#= utf #>(src, span.Length - 1, out var advance);
            Advance(advance);
            return result;
        }
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public void ReadWhiteSpace()
    {
        for (var i = m_Advanced; i < m_Json.Length; i++)
        {
            if (StringHelper.IsWhiteSpace(m_Json[i])) continue;
            Advance(i - m_Advanced);
            return;
        }
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public void ReadBeginObject() => ReadChar('{');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public void ReadEndObject() => ReadChar('}');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public void ReadBeginArray() => ReadChar('[');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public void ReadEndArray() => ReadChar(']');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public void ReadKeyBegin() => ReadChar(':');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public void ReadComma() => ReadChar(',');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public bool TryReadBeginObject() => TryReadChar('{');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public bool TryReadEndObject() => TryReadChar('}');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public bool TryReadBeginArray() => TryReadChar('[');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public bool TryReadEndArray() => TryReadChar(']');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public bool TryReadKeyBegin() => TryReadChar(':');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public bool TryReadComma() => TryReadChar(',');

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public bool TryReadNull()
    {
        var length = m_Json.Length - m_Advanced;
        var span = m_Json.Slice(m_Advanced, length);
        // Up to 4 characters are needed, hence the length of Length - 3
        for (var i = 0; i < span.Length - 3; i++)
        {
            if (StringHelper.IsWhiteSpace(span[i])) continue;
            // Find consecutive nulls
            if (span[i] == <#= castStr #>'n' && span[i + 1] == <#= castStr #>'u' && span[i + 2] == <#= castStr #>'l' && span[i + 3] == <#= castStr #>'l')
            {
                Advance(i + 4);
                return true;
            }
            return false;
        }
        return false;
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public ReadOnlySpan<<#= charType #>> ReadKey()
    {
        ReadWhiteSpace();
        var key = ReadString();
        ReadWhiteSpace();
        ReadKeyBegin();
        ReadWhiteSpace();
        return key;
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    public bool TryReadKey(out ReadOnlySpan<<#= charType #>> key)
    {
        ReadWhiteSpace();
        if (remains[0] != <#= castStr #>'"')
        {
            key = default;
            return false;
        }
        key = ReadString();
        ReadWhiteSpace();
        ReadKeyBegin();
        ReadWhiteSpace();
        return true;
    }

    private ReadOnlySpan<<#= charType #>> ReadString()
    {
        if (m_Json[m_Advanced] != <#= castStr #>'"')
        {
            throw SerdeException.ThrowInvalidJson(m_Json.ToString());
        }

        for (var i = m_Advanced + 1; i < m_Json.Length; i++)
        {
            if (m_Json[i].Equals(<#= castStr #>'"') && m_Json[i - 1] != <#= castStr #>'\\')
            {
                var result = m_Json.Slice(m_Advanced + 1, i - m_Advanced - 1);
                Advance(i + 1 - m_Advanced);
                return result;
            }
        }
        throw SerdeException.ThrowInvalidJson(m_Json.ToString());
    }

    /// <summary>
    /// Reads characters until the first target character is encountered
    /// </summary>
    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    private void ReadChar(char c)
    {
        ReadWhiteSpace();
        if (remains[0] != <#= castStr #>c)
        {
            throw SerdeException.ThrowInvalidJson(m_Json.ToString());
        }
        Advance(1);
    }

    /// <summary>
    /// Reads characters until the first target character is encountered
    /// </summary>
    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    private bool TryReadChar(char c)
    {
        var length = m_Json.Length - m_Advanced;
        var span = m_Json.Slice(m_Advanced, length);
        for (var i = 0; i < span.Length; i++)
        {
            if (StringHelper.IsWhiteSpace(span[i])) continue;
            if (span[i] == <#= castStr#>c)
            {
                Advance(i + 1);
                return true;
            }
            return false;
        }
        return false;
    }

    [MethodImpl(MethodImplOptions.AggressiveInlining)]
    private static unsafe bool TryGetIndexFromSpan(ref ReadOnlySpan<<#= charType #>> span, int length, <#= charType #> character, out int index)
    {
        fixed (<#= charType #>* ptr = span)
        {
            index = StringHelper.IndexOf(ptr, length, character);
        }
        return index != -1;
    }
    #endregion
}
<#
}
#>
