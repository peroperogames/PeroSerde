<#@ template language="C#" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#
(string type, string ctor, string cmp)[] builtinTypes =
[
    ("BoolType", "true", string.Empty),
    ("CharType", "'\\ufff0'", string.Empty),
    ("ByteType", "10", string.Empty),
    ("SbyteType", "10", string.Empty),
    ("ShortType", "10", string.Empty),
    ("UshortType", "10", string.Empty),
    ("IntType", "10", string.Empty),
    ("UintType", "10", string.Empty),
    ("LongType", "10", string.Empty),
    ("UlongType", "10", string.Empty),
    ("FloatType", "10.4f", string.Empty),
    ("DoubleType", "10.4d", string.Empty),
    ("DecimalType", "13/2", string.Empty),
    ("NullableBoolType", "null", string.Empty),
    ("NuallableCharType", "null", string.Empty),
    ("NuallableByteType", "null", string.Empty),
    ("NuallableSbyteType", "null", string.Empty),
    ("NuallableShortType", "null", string.Empty),
    ("NuallableUshortType", "null", string.Empty),
    ("NuallableIntType", "null", string.Empty),
    ("NuallableUintType", "null", string.Empty),
    ("NuallableLongType", "null", string.Empty),
    ("NuallableUlongType", "null", string.Empty),
    ("NuallableFloatType", "null", string.Empty),
    ("NuallableDoubleType", "null", string.Empty),
    ("NuallableDecimalType", "null", string.Empty),
    ("StringType", "\"String\"", string.Empty),
    ("DateTimeType", "DateTime.Now", ".value.ToString()"),
    ("UnixMillisecondDateTimeType", "DateTime.Now", ".value.ToString()"),
    ("UnixSecondDateTimeType", "DateTime.Now", ".value.ToString()"),
    ("Vector2Type", "new Vector2(0.5f, 0.5f)", string.Empty),
    ("Vector3Type", "new Vector3(0.5f, 0.5f, 0.5f)", string.Empty),
    ("Vector4Type", "new Vector4(0.5f, 0.5f, 0.5f, 0.5f)", string.Empty),
    ("ColorType", "new Color(0.5f, 0.5f, 0.5f, 0.5f)", string.Empty),
    ("HexColorType", "new Color(0.5f, 0.5f, 0.5f, 0.5f)", string.Empty),
    ("GuidType", "Guid.NewGuid()", string.Empty)
];
#>
