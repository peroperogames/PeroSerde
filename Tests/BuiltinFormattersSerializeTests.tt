using System;
using UnityEngine;
using NUnit.Framework;

namespace PeroTools2.Serde.Editor.Tests
{
    public sealed class BuiltinFormattersSerializeTests
    {
<#
    for (var i = 0; i < builtinTypes.Length; i++)
    {
        var type = builtinTypes[i].type;
        var ctor = builtinTypes[i].ctor;
        var cmp = builtinTypes[i].cmp;
#>

         [TestCase(Encoding.UTF8)]
         [TestCase(Encoding.UTF16)]
         public void <#= type.Replace("Type","") #>Test(Encoding encoding)
         {
             var obj = new <#= type #>(<#= ctor #>);
             var json = encoding == Encoding.UTF8
                 ? System.Text.Encoding.UTF8.GetString(JsonConverter.SerializeUtf8(obj))
                 : JsonConverter.SerializeUtf16(obj);
             Assert.AreEqual(obj<#= cmp #>, Newtonsoft.Json.JsonConvert.DeserializeObject<<#= type #>>(json)<#= cmp #>);
         }
<#
    }
#>
    }
}