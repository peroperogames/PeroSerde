<#@ template language="C#" #>
<#
// Serialization always allocates a string, so exactly one allocation is expected.
var emitNoGc = false;
(string type, string ctor, int serializeAllocateTimes, int deserializeAllocateTimes)[] builtinTypes =
[
    ("BoolType", "new BoolType(true)", 1, 0),
    ("CharType", "new CharType('\\ufff0')", 1, 0),
    ("ByteType", "new ByteType(10)", 1, 0),
    ("SbyteType", "new SbyteType(10)", 1, 0),
    ("ShortType", "new ShortType(10)", 1, 0),
    ("UshortType", "new UshortType(10)", 1, 0),
    ("IntType", "new IntType(10)", 1, 0),
    ("UintType", "new UintType(10)", 1, 0),
    ("LongType", "new LongType(10)", 1, 0),
    ("UlongType", "new UlongType(10)", 1, 0),
    ("FloatType", "new FloatType(10.4f)", 1, 0),
    ("DoubleType", "new DoubleType(10.4d)", 1, 0),
    ("DecimalType", "new DecimalType(13/2)", 1, 0),
    ("NullableBoolType", "new NullableBoolType(null)", 1, 0),
    ("NullableCharType", "new NullableCharType(null)", 1, 0),
    ("NullableByteType", "new NullableByteType(null)", 1, 0),
    ("NullableSbyteType", "new NullableSbyteType(null)", 1, 0),
    ("NullableShortType", "new NullableShortType(null)", 1, 0),
    ("NullableUshortType", "new NullableUshortType(null)", 1, 0),
    ("NullableIntType", "new NullableIntType(null)", 1, 0),
    ("NullableUintType", "new NullableUintType(null)", 1, 0),
    ("NullableLongType", "new NullableLongType(null)", 1, 0),
    ("NullableUlongType", "new NullableUlongType(null)", 1, 0),
    ("NullableFloatType", "new NullableFloatType(null)", 1, 0),
    ("NullableDoubleType", "new NullableDoubleType(null)", 1, 0),
    ("NullableDecimalType", "new NullableDecimalType(null)", 1, 0),

    ("StringBoolType", "new StringBoolType(true)", 1, 0),
    ("StringByteType", "new StringByteType(10)", 1, 0),
    ("StringSbyteType", "new StringSbyteType(10)", 1, 0),
    ("StringShortType", "new StringShortType(10)", 1, 0),
    ("StringUshortType", "new StringUshortType(10)", 1, 0),
    ("StringIntType", "new StringIntType(10)", 1, 0),
    ("StringUintType", "new StringUintType(10)", 1, 0),
    ("StringLongType", "new StringLongType(10)", 1, 0),
    ("StringUlongType", "new StringUlongType(10)", 1, 0),
    ("StringFloatType", "new StringFloatType(10.4f)", 1, 0),
    ("StringDoubleType", "new StringDoubleType(10.4d)", 1, 0),
    ("StringDecimalType", "new StringDecimalType(13/2)", 1, 0),
    ("StringNullableBoolType", "new StringNullableBoolType(null)", 1, 0),
    ("StringNullableByteType", "new StringNullableByteType(null)", 1, 0),
    ("StringNullableSbyteType", "new StringNullableSbyteType(null)", 1, 0),
    ("StringNullableShortType", "new StringNullableShortType(null)", 1, 0),
    ("StringNullableUshortType", "new StringNullableUshortType(null)", 1, 0),
    ("StringNullableIntType", "new StringNullableIntType(null)", 1, 0),
    ("StringNullableUintType", "new StringNullableUintType(null)", 1, 0),
    ("StringNullableLongType", "new StringNullableLongType(null)", 1, 0),
    ("StringNullableUlongType", "new StringNullableUlongType(null)", 1, 0),
    ("StringNullableFloatType", "new StringNullableFloatType(null)", 1, 0),
    ("StringNullableDoubleType", "new StringNullableDoubleType(null)", 1, 0),
    ("StringNullableDecimalType", "new StringNullableDecimalType(null)", 1, 0),

    // Deserialization allocates the string itself: exactly one allocation.
    ("StringType", "new StringType(\"String\")", 1, 1),
    ("DateTimeType", "new DateTimeType(DateTime.Now)", 1, 0),
    ("UnixMillisecondDateTimeType", "new UnixMillisecondDateTimeType(DateTime.Now)", 1, 0),
    ("UnixSecondDateTimeType", "new UnixSecondDateTimeType(DateTime.Now)", 1, 0),
    ("GuidType", "new GuidType(Guid.NewGuid())", 1, 0),
    ("BoolType[]", "new BoolType[] { new(true), new(false) }", 1, 1),
    ("List<BoolType>", "new List<BoolType> { new(true), new(false) }", 1, 2),
    // The list plus its resizing buffer: two allocations.
    ("ListNumberType", "new ListNumberType(new List<int> { 1, 2, 3, 4 })", 1, 2),
    // The list plus its resizing buffer: two allocations.
    ("ListObjectType", "new ListObjectType(new List<BoolType> { new BoolType(true), new BoolType(false) })", 1, 2),
    // The dictionary owns an int array and an entry array, so three allocations.
    ("DictionaryNumberType", "new DictionaryNumberType(new Dictionary<int, BoolType> { {1, new BoolType(true)}, {2, new BoolType(false)} })", 1 , 3),
    // Dictionary (int array + entry array) plus the strings: five allocations.
    ("DictionaryStringType", "new DictionaryStringType(new Dictionary<string, BoolType> { {\"True\", new BoolType(true)}, {\"False\", new BoolType(false)} })", 1, 5),
    ("NumberEnumType", "new NumberEnumType(NumberEnum.BEnum)", 1 ,0),
    ("StringEnumType", "new StringEnumType(StringEnum.BEnum)", 1 ,0),
    ("StringNumberEnumType", "new StringNumberEnumType(StringNumberEnum.BEnum)", 1 ,0),
    ("NumberStringEnumType", "new NumberStringEnumType(NumberStringEnum.BEnum)", 1, 0),
    ("NumberFlagsType", "new NumberFlagsType(NumberFlags.BFlag | NumberFlags.CFlag)", 1 ,0),
    ("StringFlagsType", "new StringFlagsType(StringFlags.BFlag | StringFlags.CFlag)", 1, 0),
    // A Lazy wrapper plus a string: two allocations.
    ("LazyType", "new LazyType(new Lazy<string>(\"LazyString\"))", 1, 2),
    ("NullableType", "new NullableType(new BoolType(true))", 1, 0),
    // The list plus its resizing buffer: two allocations.
    ("GenericTypeCollection", "new GenericTypeCollection(new List<GenericType<int>> { new GenericType<int>(1), new GenericType<int>(2) })", 1, 2)
];
#>
