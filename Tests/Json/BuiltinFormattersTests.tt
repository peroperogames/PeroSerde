<#@ template language="C#" #>
<#
// 由于序列化一定会分配字符串，因此一定会有一次分配
(string type, string ctor, int serializeAllocateTimes, int deserializeAllocateTimes)[] builtinTypes =
[
    ("BoolType", "true", 1, 0),
    ("CharType", "'\\ufff0'", 1, 0),
    ("ByteType", "10", 1, 0),
    ("SbyteType", "10", 1, 0),
    ("ShortType", "10", 1, 0),
    ("UshortType", "10", 1, 0),
    ("IntType", "10", 1, 0),
    ("UintType", "10", 1, 0),
    ("LongType", "10", 1, 0),
    ("UlongType", "10", 1, 0),
    ("FloatType", "10.4f", 1, 0),
    ("DoubleType", "10.4d", 1, 0),
    ("DecimalType", "13/2", 1, 0),
    ("NullableBoolType", "null", 1, 0),
    ("NuallableCharType", "null", 1, 0),
    ("NuallableByteType", "null", 1, 0),
    ("NuallableSbyteType", "null", 1, 0),
    ("NuallableShortType", "null", 1, 0),
    ("NuallableUshortType", "null", 1, 0),
    ("NuallableIntType", "null", 1, 0),
    ("NuallableUintType", "null", 1, 0),
    ("NuallableLongType", "null", 1, 0),
    ("NuallableUlongType", "null", 1, 0),
    ("NuallableFloatType", "null", 1, 0),
    ("NuallableDoubleType", "null", 1, 0),
    ("NuallableDecimalType", "null", 1, 0),
    // 由于String自己会有一次分配，因此反序列化会有一次分配
    ("StringType", "\"String\"", 1, 1),
    ("DateTimeType", "DateTime.Now", 1, 0),
    ("UnixMillisecondDateTimeType", "DateTime.Now", 1, 0),
    ("UnixSecondDateTimeType", "DateTime.Now", 1, 0),
    ("Vector2Type", "new Vector2(0.5f, 0.5f)", 1, 0),
    ("Vector3Type", "new Vector3(0.5f, 0.5f, 0.5f)", 1, 0),
    ("Vector4Type", "new Vector4(0.5f, 0.5f, 0.5f, 0.5f)", 1, 0),
    ("Vector2IntType", "new Vector2Int(12, 34)", 1, 0),
    ("Vector3IntType", "new Vector3Int(12, 34, 56)", 1, 0),
    ("QuaternionType", "new Quaternion(0.5f, 0.5f, 0.5f, 0.5f)", 1, 0),
    ("ColorType", "new Color(0.5f, 0.5f, 0.5f, 0.5f)", 1, 0),
    ("HexColorType", "new Color(0.5f, 0.5f, 0.5f, 0.5f)", 1 ,0),
    ("GuidType", "Guid.NewGuid()", 1, 0),
    // 由于List存在扩容，加上List本身需要创建，因此反序列化会有两次分配
    ("ListNumberType", "new List<int> { 1, 2, 3, 4 }", 1, 2),
    // 由于List存在扩容，加上List本身需要创建，因此反序列化会有两次分配
    ("ListObjectType", "new List<BoolType> { new BoolType(true), new BoolType(false) }", 1, 2),
    // 由于Dictionary本身需要创建（包含一个int数组和一个Entry数组），因此反序列化会有三次分配
    ("DictionaryNumberType", "new Dictionary<int, BoolType> { {1, new BoolType(true)}, {2, new BoolType(false)} }", 1 , 3),
    // 由于Dictionary本身需要创建（包含一个int数组和一个Entry数组），String对象也需要创建，因此反序列化会有五次分配
    ("DictionaryStringType", "new Dictionary<string, BoolType> { {\"True\", new BoolType(true)}, {\"False\", new BoolType(false)} }", 1, 5),
    ("NumberEnumType", "NumberEnum.BEnum", 1 ,0),
    ("StringEnumType", "StringEnum.BEnum", 1 ,0),
    ("StringNumberEnumType", "StringNumberEnum.BEnum", 1 ,0),
    ("NumberStringEnumType", "NumberStringEnum.BEnum", 1, 0),
    ("NumberFlagsType", "NumberFlags.BFlag | NumberFlags.CFlag", 1 ,0),
    ("StringFlagsType", "StringFlags.BFlag | StringFlags.CFlag", 1, 0),
    // 由于会生成一个Lazy对象和一个String对象，因此反序列化会有两次分配
    ("LazyType", "new Lazy<string>(\"LazyString\")", 1, 2),
    ("NullableType", "new BoolType(true)", 1, 0),
    // 由于List存在扩容，加上List本身需要创建，因此反序列化会有两次分配
    ("GenericTypeCollection", "new List<GenericType<int>> { new GenericType<int>(1), new GenericType<int>(2) }", 1, 2)
];
#>
/*
 * Copyright (c) PeroPeroGames Co., Ltd.
 * Author: Gatongone
 * Created On: 2024/12/25
 */

using System;
using System.Collections.Generic;
using UnityEngine;
using NUnit.Framework;
using PeroTools2.Serde.Editor.Tests;

namespace PeroTools2.Serde.Json.Editor.Tests
{
    public sealed class BuiltinFormattersTests
    {
<#
    for (var i = 0; i < builtinTypes.Length; i++)
    {
        var type = builtinTypes[i].type;
        var ctor = builtinTypes[i].ctor;
        var serializeAllocateTimes = builtinTypes[i].serializeAllocateTimes;
        var deserializeAllocateTimes = builtinTypes[i].deserializeAllocateTimes;
#>
        [TestCase(Encoding.UTF8)]
        [TestCase(Encoding.UTF16)]
        public void <#= type.Replace("Type","") #>SerializeTest(Encoding encoding)
        {
            var obj = new <#= type #>(<#= ctor #>);
            var json = encoding == Encoding.UTF8
                ? System.Text.Encoding.UTF8.GetString(JsonConverter.UTF8.Serialize(obj))
                : JsonConverter.UTF16.Serialize(obj);
            Assert.AreEqual(obj, Newtonsoft.Json.JsonConvert.DeserializeObject<<#= type #>>(json));
        }

        [TestCase(Encoding.UTF8)]
        [TestCase(Encoding.UTF16)]
        public void <#= type.Replace("Type", "") #>DeserializeTest(Encoding encoding)
        {
            var obj = new <#= type #>(<#= ctor #>);
            var json = Newtonsoft.Json.JsonConvert.SerializeObject(obj);
            var newObj = encoding == Encoding.UTF8
                ? JsonConverter.UTF8.Deserialize<<#= type #>>(System.Text.Encoding.UTF8.GetBytes(json))
                : JsonConverter.UTF16.Deserialize<<#= type #>>(json);
            Assert.AreEqual(obj, newObj);
        }

        [TestCase(Encoding.UTF8)]
        [TestCase(Encoding.UTF16)]
        public void <#= type.Replace("Type", "") #>SerializeNoGCTest(Encoding encoding)
        {
            var obj = new <#= type #>(<#= ctor #>);
            // 先进行一次调用，解决对象池的问题
            Serialize(encoding, obj);

            var action = new TestDelegate(() => { Serialize(encoding, obj); });
            // 因为会序列化出来字符串，所以必然会有分配
            Assert.That(action, Is.Not.AllocatingGCMemory(<#= serializeAllocateTimes #>));

            static void Serialize(Encoding encodingType, <#= type #> serializeObj)
            {
                if (encodingType == Encoding.UTF8)
                {
                    JsonConverter.UTF8.Serialize(serializeObj);
                }
                else
                {
                    JsonConverter.UTF16.Serialize(serializeObj);
                }
            }
        }

        [TestCase(Encoding.UTF8)]
        [TestCase(Encoding.UTF16)]
        public void <#= type.Replace("Type", "") #>DeserializeNoGCTest(Encoding encoding)
        {
            var obj = new <#= type #>(<#= ctor #>);
            var json = Newtonsoft.Json.JsonConvert.SerializeObject(obj);
            var utf8Bytes = encoding == Encoding.UTF8 ? System.Text.Encoding.UTF8.GetBytes(json) : null;
            // 先调用一次，解决对象池的分配
            Deserialize(encoding, json, utf8Bytes);

            var action = new TestDelegate(() => { Deserialize(encoding, json, utf8Bytes); });
            Assert.That(action, Is.Not.AllocatingGCMemory(<#= deserializeAllocateTimes #>));

            static void Deserialize(Encoding encodingType, string jsonText, byte[] utf8)
            {
                if (encodingType == Encoding.UTF8)
                {
                    JsonConverter.UTF8.Deserialize<<#= type #>>(utf8);
                }
                else
                {
                    JsonConverter.UTF16.Deserialize<<#= type #>>(jsonText);
                }
            }
        }
<#
    }
#>
    }
}