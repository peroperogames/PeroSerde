using System;
using UnityEngine;
using NUnit.Framework;

namespace PeroTools2.Serde.Editor.Tests
{
    public sealed class BuiltinFormattersDeserializeTests
    {
<#
    for (var i = 0; i < builtinTypes.Length; i++)
    {
        var type = builtinTypes[i].type;
        var ctor = builtinTypes[i].ctor;
#>

         [TestCase(Encoding.UTF8)]
         [TestCase(Encoding.UTF16)]
         public void <#= type.Replace("Type", "") #>Test(Encoding encoding)
         {
             var obj = new <#= type #>(<#= ctor #>);
             var json = Newtonsoft.Json.JsonConvert.SerializeObject(obj);

             var newObj = encoding == Encoding.UTF8
                 ? JsonConverter.DeserializeUtf8<<#= type #>>(System.Text.Encoding.UTF8.GetBytes(json))
                 : JsonConverter.DeserializeUtf16<<#= type #>>(json);
             Assert.AreEqual(obj, newObj);
         }
<#
    }
#>
    }
}